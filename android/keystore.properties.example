# Release signing. Copy to android/keystore.properties (git-ignored) and fill in.
# Create the keystore once, keep it and its passwords in a safe place: losing it means
# installed apps can no longer be updated.
#   keytool -genkeypair -v -keystore melkcrm-release.jks -alias melkcrm -keyalg RSA -keysize 4096 -validity 10000
# Relative paths are resolved from android/; an absolute path outside the repository is safest.
storeFile=/path/outside/the/repository/melkcrm-release.jks
storePassword=
keyAlias=melkcrm
keyPassword=
