# Backend configuration. Copy to backend/.env for local development and fill in real values.
# backend/.env is git-ignored: never commit it, and never put any of these values in the Android app.
# The backend reads only environment variables (see backend/src/main/kotlin/ir/melkcrm/backend/Config.kt).

# HTTP port the server listens on (put a TLS reverse proxy such as nginx in front of it in production).
PORT=8080

# PostgreSQL 14+ (JDBC URL). Flyway creates and migrates the schema on start.
DATABASE_URL=jdbc:postgresql://localhost:5432/melkcrm
DATABASE_USER=melkcrm
DATABASE_PASSWORD=local-dev-password-change-me
# Maximum database connections the server holds open.
DATABASE_POOL_SIZE=10

# Used by docker-compose.yml to create the database container (keep equal to the values above).
POSTGRES_DB=melkcrm
POSTGRES_USER=melkcrm
POSTGRES_PASSWORD=local-dev-password-change-me

# Signing secret for access tokens: at least 32 random characters. Generate one with
#   openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
JWT_ISSUER=melkcrm
JWT_AUDIENCE=melkcrm-app
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Property photos are stored here under random names, outside any web root. Back this folder up.
IMAGE_DIR=./data/images

# First start only: when the database has no agency yet, the server creates this agency and an
# owner/admin account with this login. The password must be at least 12 characters and is stored as a
# bcrypt hash. Remove these three lines after the first start and change the password in the app.
BOOTSTRAP_AGENCY_NAME=املاک نمونه
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=
